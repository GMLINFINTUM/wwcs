{"background_color":"#0b3d5c","categories":["weather","news"],"description":"Live, community-powered weather for Washington State. Check forecasts, radar, and NWS alerts — or become a volunteer weather spotter.","display":"standalone","icons":[{"purpose":"any","sizes":"192x192","src":"/icon-192.png","type":"image/png"},{"purpose":"any","sizes":"512x512","src":"/icon-512.png","type":"image/png"},{"purpose":"maskable","sizes":"192x192","src":"/icon-maskable-192.png","type":"image/png"},{"purpose":"maskable","sizes":"512x512","src":"/icon-maskable-512.png","type":"image/png"}],"id":"/","lang":"en","name":"Washington Weather and Climate Services","orientation":"portrait","scope":"/","short_name":"WWCS","start_url":"/","theme_color":"#0b3d5c"}